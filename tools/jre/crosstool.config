CT_CONFIG_VERSION="4"
# glibc 2.23 and Linux 3.10 headers are listed as obsolete by crosstool-ng.
CT_OBSOLETE=y
CT_PREFIX_DIR="/opt/x-tools/${CT_TARGET}"
CT_LOG_PROGRESS_BAR=n
CT_ARCH_ARM=y
# The Verse's firmware is built for ARMv7 with VFPv3 and NEON, soft-float calls.
CT_ARCH_CPU="cortex-a7"
CT_ARCH_FPU="neon"
CT_ARCH_FLOAT_SOFTFP=y
CT_TARGET_VENDOR="pocketbook"
CT_KERNEL_LINUX=y
# Retain Linux 3.10 as the minimum syscall ABI for both runtime profiles.
# Docker selects the glibc version; 2.23 is the original reproducible default.
CT_LINUX_V_3_10=y
CT_GLIBC_V_2_23=y
CT_GCC_V_13=y
CT_CC_LANG_CXX=y
